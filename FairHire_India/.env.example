# FairHire India - Environment Configuration Example
# Copy to .env and configure local secret values if running outside default Streamlit mode

FAIRHIRE_ENV=development
SECRET_KEY=change_this_to_a_secure_random_string_in_production
DATABASE_URL=sqlite:///database/fairhire.db

# Bootstrap Admin / Recruiter Credentials
INITIAL_RECRUITER_EMAIL=recruiter@fairhire.in
INITIAL_RECRUITER_PASSWORD=FairHire@Admin2026

# Model & Fairness Settings
MODEL_RANDOM_STATE=42
DATASET_TARGET_SIZE=1000
